<?xml version="1.0" encoding="utf-8"?>
<!--
  The TherapyTrack mark: a head in profile with the brain drawn as three
  soft folds, in champagne. Drawn inside the 66dp safe circle of the 108dp
  adaptive-icon canvas so no launcher mask clips it. Also used as the
  monochrome layer, so it is a single colour and reads at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- thin ring, echoing the circle behind the mark on the iOS hero -->
    <path
        android:strokeColor="#F7D794" android:strokeWidth="1.6" android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M54,54m-28,0a28,28 0 1,1 56,0a28,28 0 1,1 -56,0" />

    <!-- head in profile, facing right: cranium arc, brow, nose, lip, chin, neck -->
    <path
        android:strokeColor="#F7D794" android:strokeWidth="4.2"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="
            M47,76
            C42,74 35,68 34,60
            C33,50 37,38 48,34
            C58,30 70,35 73,45
            C75,50 74,53 76,56
            L79,60 L75,61
            C75,64 76,66 73,67
            C73,70 71,72 66,71
            C63,73 60,74 58,78" />

    <!-- brain: three folds inside the cranium -->
    <path
        android:strokeColor="#F7D794" android:strokeWidth="3.4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="
            M44,52 C46,45 53,42 59,45
            M43,60 C48,55 55,53 62,55
            M48,66 C51,62 57,61 62,63" />
</vector>
